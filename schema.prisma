datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  ADMIN
  EDITOR
  VIEWER
}

model User {
  id           String       @id @default(uuid())
  name         String?
  role         UserRole     @default(EDITOR)
  forms        Form[]
  formAccesses FormAccess[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Form {
  id           String         @id @default(uuid())
  title        String
  description  String?
  fields       Json
  settings     Json?
  isTemplate   Boolean        @default(false)
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  submissions  Submission[]
  formAccesses FormAccess[]
  uploadedFiles UploadedFile[]
  auditEvents  AuditEvent[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model AuditEvent {
  id          String   @id @default(uuid())
  formId      String?
  formTitle   String?
  form        Form?    @relation(fields: [formId], references: [id], onDelete: SetNull)
  actorUserId String?
  actorEmail  String?
  actorName   String?
  action      String
  entityType  String
  entityId    String?
  summary     String
  changes     Json?
  createdAt   DateTime @default(now())

  @@index([formId, createdAt])
  @@index([createdAt])
  @@index([action])
  @@index([actorUserId])
}

model UploadedFile {
  id           String   @id @default(uuid())
  formId       String
  form         Form     @relation(fields: [formId], references: [id], onDelete: Cascade)
  originalName String
  mimeType     String
  sizeBytes    Int
  path         String
  createdAt    DateTime @default(now())
}

model FormAccess {
  id        String   @id @default(uuid())
  formId    String
  form      Form     @relation(fields: [formId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId    String   @default("viewer")
  createdAt DateTime @default(now())

  @@unique([formId, userId])
}

model Submission {
  id        String   @id @default(uuid())
  formId    String
  form      Form     @relation(fields: [formId], references: [id], onDelete: Cascade)
  data      Json
  context   Json?
  editToken String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([formId])
}
